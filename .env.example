# Local production-style run
NODE_ENV=production
HOST=127.0.0.1
PORT=3000
LOCAL_DESKTOP_MODE=1
LOCAL_DATA_DIR=.local-data

# Hetzner hosted requirements (disable LOCAL_DESKTOP_MODE first)
DATABASE_URL=
JWT_SECRET=
CREDENTIAL_ENCRYPTION_KEY=
VITE_APP_ID=
OAUTH_SERVER_URL=https://example.invalid
# Optional HAI read-only aggregate connector
HAI_CONNECTOR_ENABLED=false
HAI_CONNECTOR_TOKEN=
HAI_CONNECTOR_USER_ID=
