{
  "name": "multi-platform-reach-out",
  "version": "1.0.0",
  "description": "Desktop and hosted outreach tool for Nationale Hulpgids campaigns.",
  "author": "Noodzakelijk Online",
  "type": "module",
  "main": "desktop/main.cjs",
  "license": "MIT",
  "scripts": {
    "dev": "cross-env NODE_ENV=development USE_VITE_DEV_SERVER=true tsx watch server/_core/index.ts",
    "build": "node scripts/build.cjs",
    "start": "cross-env NODE_ENV=production node dist/index.js",
    "start:local": "cross-env NODE_ENV=production LOCAL_DESKTOP_MODE=1 LOCAL_DATA_DIR=.local-data node dist/index.js",
    "installer:win": "pnpm build && cross-env ELECTRON_CACHE=.electron-cache electron_config_cache=.electron-cache ELECTRON_BUILDER_CACHE=.electron-builder-cache electron-builder --win nsis --publish never",
    "installer:win:signed": "pnpm build && cross-env ELECTRON_CACHE=.electron-cache electron_config_cache=.electron-cache ELECTRON_BUILDER_CACHE=.electron-builder-cache electron-builder --win nsis --publish never -c.win.signAndEditExecutable=true",
    "check": "tsc --noEmit",
    "format": "prettier --write .",
    "test": "vitest run --configLoader runner --maxWorkers=1 --no-file-parallelism --testTimeout=15000 --hookTimeout=15000",
    "test:live-scrapers": "cross-env RUN_LIVE_SCRAPER_TESTS=1 vitest run server/enhancements.test.ts --configLoader runner --maxWorkers=1 --no-file-parallelism --testTimeout=15000 --hookTimeout=15000",
    "test:e2e": "pnpm build && playwright test",
    "doctor": "node scripts/doctor.cjs",
    "doctor:built": "node scripts/doctor.cjs --built",
    "backup:local": "node scripts/local-data.cjs backup",
    "verify:backup": "node scripts/local-data.cjs verify",
    "restore:local": "node scripts/local-data.cjs restore",
    "connector:hai": "node scripts/hai-connector.cjs",
    "db:push": "drizzle-kit generate && drizzle-kit migrate"
  },
  "dependencies": {
    "@trpc/server": "^11.19.0",
    "axios": "^1.20.0",
    "cheerio": "^1.2.0",
    "cookie": "^2.0.1",
    "crawlee": "^3.18.2",
    "dotenv": "^18.0.8",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "express-rate-limit": "8.7.1",
    "jose": "6.2.12",
    "mysql2": "^3.24.5",
    "rate-limiter-flexible": "^11.2.3",
    "superjson": "^2.2.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@hookform/resolvers": "^5.9.2",
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-aspect-ratio": "^1.2.0",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-collapsible": "^1.2.1",
    "@radix-ui/react-context-menu": "^2.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-hover-card": "^1.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-menubar": "^1.2.1",
    "@radix-ui/react-navigation-menu": "^1.4.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-progress": "^1.2.1",
    "@radix-ui/react-radio-group": "^1.5.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toggle": "^1.2.1",
    "@radix-ui/react-toggle-group": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.4",
    "@trpc/client": "^11.19.0",
    "@trpc/react-query": "^11.19.0",
    "@types/express": "5.0.6",
    "@types/google.maps": "^3.66.7",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cross-env": "^10.1.0",
    "date-fns": "^4.4.0",
    "drizzle-kit": "^0.31.11",
    "electron": "44.9.0",
    "electron-builder": "^26.15.3",
    "embla-carousel-react": "^8.6.0",
    "esbuild": "^0.28.2",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.59.0",
    "nanoid": "^6.0.2",
    "next-themes": "^0.4.6",
    "playwright": "1.64.1",
    "postcss": "^8.5.31",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.90.0",
    "react-resizable-panels": "^4.14.6",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "streamdown": "^2.7.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "7.0.2",
    "vaul": "^1.1.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "wouter": "3.13.0"
  },
  "engines": {
    "node": ">=26.12.1"
  },
  "packageManager": "pnpm@12.14.0",
  "build": {
    "appId": "nl.noodzakelijkonline.reachout",
    "productName": "Nationale Hulpgids Reach-Out",
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**/*",
      "dist/**/*",
      "desktop/icon.ico",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "**/*.node"
    ],
    "win": {
      "icon": "desktop/icon.ico",
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "installerIcon": "desktop/icon.ico",
      "uninstallerIcon": "desktop/icon.ico",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
